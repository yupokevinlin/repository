{
  "name": "@org/erp-components",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "nx": {
    "name": "erp-components",
    "targets": {
      "kill-port": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx --yes kill-port 5001"
        }
      },
      "storybook": {
        "dependsOn": [
          "kill-port"
        ],
        "options": {
          "port": 5001
        }
      },
      "test-storybook": {
        "dependsOn": [
          "build-storybook"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/erp-components",
          "command": "node ../../tools/visual-test.mjs"
        }
      }
    }
  },
  "dependencies": {
    "@org/design-library": "0.0.1",
    "@storybook/addon-docs": "^10.5.4"
  }
}
