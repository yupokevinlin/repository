{
  "name": "@org/design-library",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "nx": {
    "name": "design-library",
    "targets": {
      "kill-port": {
        "executor": "nx:run-commands",
        "options": {
          "command": "npx --yes kill-port 5000"
        }
      },
      "storybook": {
        "dependsOn": [
          "kill-port"
        ],
        "options": {
          "port": 5000
        }
      }
    }
  },
  "dependencies": {
    "@storybook/addon-docs": "^10.4.6"
  }
}
